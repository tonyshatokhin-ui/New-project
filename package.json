{
  "name": "bronze-crown",
  "version": "1.0.0",
  "private": true,
  "description": "Static strategy game prototype",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npx --yes serve -l 3000 .",
    "test": "node --test",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "format": "prettier --check \"tests/**/*.js\" \"*.{js,json,md}\" \".github/workflows/**/*.yml\"",
    "format:write": "prettier --write \"tests/**/*.js\" \"*.{js,json,md}\" \".github/workflows/**/*.yml\""
  },
  "devDependencies": {
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "three": "^0.164.1"
  }
}
